#!/usr/bin/env bash
#
# eNode-install — bootstrap eNode from a Proxmox host (single command).
#
# What it does (transparently):
#   0. Bootstraps host prerequisites (git, curl, ca-certificates).
#   1. Installs and STARTS the host display stack (Xorg) and the MQTT broker
#      (mosquitto, listening on the host IP) — BEFORE the CT needs them.
#   2. Creates an LXC CT, binds the host X socket + input + dri into it, and
#      starts the CT once the host X socket exists.
#   3. Installs Node.js + git + chromium inside the CT, clones NodeWall/e-Node.
#   4. Deploys CT-side services (backend, metrics subscriber) and the host
#      kiosk + metrics-publisher systemd units.
#   5. Verifies the full stack and reports status.
#
# ⚠️  SECURITY / SCOPE NOTE
# This script installs software DIRECTLY on the Proxmox host (Xorg, mosquitto,
# systemd units). It is intended for HOME / LAB use on a dedicated mini-server
# (e.g. a 2-in-1 convertible), NOT for production Proxmox clusters. Review the
# steps with --dry-run first, and test on a spare host.
#
# Logging: every step is printed to the terminal AND appended to the log file.

LOG="/var/log/eNode-install-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$(dirname "$LOG")"

log() {
  local ts; ts="$(date '+%Y-%m-%d %H:%M:%S')"
  printf '[%s] %s\n' "$ts" "$*" | tee -a "$LOG" >&2
}

set -uo pipefail

REPO="https://github.com/NodeWall/e-Node.git"
CT_NAME=""
CT_ID=""
NODE_HOSTNAME="$(hostname)"
STORAGE=""
TMPL_STORAGE=""
ROOTFS_STORAGE=""
TEMPLATE=""
DRY_RUN=0
HERE="$(cd "$(dirname "$0")" && pwd)"

usage() {
  log "Usage: $0 --name <eNode-pve1> [--id <vmid>] [--template <volid>] [--storage <storage>] [--dry-run]"
  log "  --name     CT hostname (default: eNode-<hostname>)"
  log "  --id       VMID (default: first free >= 300)"
  log "  --template Debian CT template volid (default: auto-detect)"
  log "  --storage  storage for CT rootfs (default: auto-detect rootdir-capable storage)"
  log "  --dry-run  print actions without executing"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) CT_NAME="$2"; shift 2 ;;
    --id) CT_ID="$2"; shift 2 ;;
    --template) TEMPLATE="$2"; shift 2 ;;
    --storage) STORAGE="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    *) usage ;;
  esac
done

[ -z "$CT_NAME" ] && CT_NAME="eNode-${NODE_HOSTNAME}"

# --- Helpers ---
run() {
  if [ "$DRY_RUN" = 1 ]; then
    log "[dry-run] $*"
    return 0
  fi
  log "RUN: $*"
  eval "$@" 2>&1 | tee -a "$LOG" >&2
  local rc=${PIPESTATUS[0]}
  if [ "$rc" -ne 0 ]; then
    log "ERROR: command failed (exit $rc): $*"
    exit 1
  fi
}

# Idempotent lxc.mount.entry append (no duplicates on re-run).
add_mount_entry() {
  local conf="$1" line="$2"
  grep -qxF "$line" "$conf" 2>/dev/null || echo "$line" >> "$conf"
}

# --- Bootstrap host prerequisites (git/curl/ca-certificates) ---
log "Bootstrap: ensuring host prerequisites (git, curl, ca-certificates)..."
if ! command -v git >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 || ! command -v ca-certificates >/dev/null 2>&1; then
  run "apt-get update -qq"
  run "apt-get install -y -qq git curl ca-certificates"
else
  log "git/curl/ca-certificates already present."
fi

# If deploy/ is not next to this script (e.g. `curl | bash`), fetch the repo so
# we have the declarative host files. Does not change architecture — just locates artifacts.
if [ ! -d "$HERE/deploy/host" ]; then
  if [ "$DRY_RUN" = 1 ]; then
    log "[dry-run] deploy/ not found next to script; would clone $REPO for deploy artifacts"
  else
    BOOT_CLONE="/tmp/e-Node-install-$$"
    log "deploy/ not found next to script (curl|bash?) — cloning $REPO to $BOOT_CLONE"
    git clone --depth 1 "$REPO" "$BOOT_CLONE" 2>&1 | tee -a "$LOG" >&2
    HERE="$BOOT_CLONE"
  fi
fi
log "Deploy artifacts dir: $HERE"

# --- Robust Storage Detection ---
# Template (vztmpl) and rootfs (rootdir) often live on DIFFERENT storages.
# Find each independently from pvesm status content columns.
if [ -z "$STORAGE" ]; then
  TMPL_STORAGE="$(pvesm status | awk '$NF ~ /vztmpl/ {print $1; exit}')"
  [ -z "$TMPL_STORAGE" ] && TMPL_STORAGE="local"
  ROOTFS_STORAGE="$(pvesm status | awk '$NF ~ /rootdir/ {print $1; exit}')"
  [ -z "$ROOTFS_STORAGE" ] && ROOTFS_STORAGE="local-lvm"
  STORAGE="$ROOTFS_STORAGE"
  log "Template storage: $TMPL_STORAGE | Rootfs storage: $ROOTFS_STORAGE"
else
  TMPL_STORAGE="$STORAGE"
  ROOTFS_STORAGE="$STORAGE"
fi
log "Target storage: $STORAGE"

# --- Template Resolution ---
CACHE_DIR="/var/lib/vz/template/cache"
find_local_template() {
  local f
  f="$(ls -1 "$CACHE_DIR" 2>/dev/null | grep -E 'debian-13-standard.*\.tar\.(zst|xz)$' | head -1)"
  [ -z "$f" ] && f="$(ls -1 "$CACHE_DIR" 2>/dev/null | grep -E 'debian.*\.tar\.(zst|xz)$' | head -1)"
  [ -n "$f" ] && echo "${TMPL_STORAGE}:vztmpl/$f"
}

if [ -z "$TEMPLATE" ]; then
  log "Searching for a Debian template on $TMPL_STORAGE ..."
  TEMPLATE="$(find_local_template)"
fi

if [ -z "$TEMPLATE" ]; then
  log "No Debian template found locally. Attempting auto-download (needs internet)..."
  pveam update 2>&1 | tee -a "$LOG" >&2 || true
  TMPL="$(pveam available 2>/dev/null | awk 'NR>1 && /debian-13-standard/ {for(i=1;i<=NF;i++) if($i ~ /debian-13-standard.*\.tar\.(zst|xz)$/) {print $i; exit}}')"
  if [ -z "$TMPL" ]; then
    TMPL="$(pveam available 2>/dev/null | awk 'NR>1 && /debian/ {for(i=1;i<=NF;i++) if($i ~ /debian.*\.tar\.(zst|xz)$/) {print $i; exit}}')"
  fi
  if [ -n "$TMPL" ]; then
    log "Downloading template: $TMPL → $TMPL_STORAGE"
    pveam download "$TMPL_STORAGE" "$TMPL" 2>&1 | tee -a "$LOG" >&2
    TEMPLATE="$(find_local_template)"
    [ -n "$TEMPLATE" ] && log "Template volid: $TEMPLATE"
  fi
fi
[ -z "$TEMPLATE" ] && { log "ERROR: no Debian template available on $TMPL_STORAGE."; exit 1; }

if [ -z "$CT_ID" ]; then
  for id in $(seq 300 399); do
    pct status "$id" >/dev/null 2>&1 || { CT_ID="$id"; break; }
  done
fi
[ -z "$CT_ID" ] && { log "ERROR: no free VMID in 300-399"; exit 1; }

log "CT hostname: $CT_NAME | VMID: $CT_ID"

# Host IP — needed by mosquitto listener, backend config and metrics subscriber.
HOST_IP="$(ip route get 1 2>/dev/null | awk '{print $7; exit}')"
[ -z "$HOST_IP" ] && HOST_IP="$(hostname -I | awk '{print $1}')"
[ -z "$HOST_IP" ] && { log "ERROR: could not determine host IP."; exit 1; }
log "Host IP: $HOST_IP"

# Ensure the CT will have DNS (some PVE images ship an empty resolv.conf).
if ! grep -qE '^nameserver[[:space:]]+[0-9]{1,3}(\.[0-9]{1,3}){3}$' /etc/resolv.conf 2>/dev/null; then
  log "Host /etc/resolv.conf has no valid nameserver — writing a clean one (1.1.1.1)"
  cp /etc/resolv.conf /etc/resolv.conf.eNode-bak 2>/dev/null || true
  printf 'nameserver 1.1.1.1\n' > /etc/resolv.conf
fi

# =====================================================================
# HOST PHASE — display stack + MQTT broker MUST exist before the CT starts
# (the CT binds /tmp/.X11-unix/X0, which only exists once Xorg is running).
# =====================================================================
log "Step 1/6: Installing host display stack (Xorg) + MQTT broker (mosquitto)..."
run "apt-get install -y -qq xserver-xorg-core xserver-xorg-input-libinput x11-xserver-utils libinput-bin intel-microcode iucode-tool mosquitto mosquitto-clients"
# Verify the Xorg libinput input driver is actually present (no hard-coded path)
if ! dpkg -L xserver-xorg-input-libinput 2>/dev/null | grep -q '/libinput_drv\.so$'; then
  log "ERROR: xserver-xorg-input-libinput installed but libinput_drv.so not found — input (touch/keyboard) will not work."
  exit 1
fi
log "Verified: Xorg libinput input driver (libinput_drv.so) is present."

run "mkdir -p /etc/X11/xorg.conf.d /etc/mosquitto/conf.d /opt/enode/bin"
run "install -m 0644 '$HERE/deploy/host/xorg.conf' /etc/X11/xorg.conf"
run "install -m 0644 '$HERE/deploy/host/xorg.conf.d/'* /etc/X11/xorg.conf.d/"
# Mosquitto config: substitute HOST_IP for listener (R1 — broker must listen on host IP, not loopback only)
run "sed \"s/ENODE_HOST_IP/$HOST_IP/g\" '$HERE/deploy/host/mosquitto/enode.conf' > /etc/mosquitto/conf.d/enode.conf"
for u in xorg-core metrics-publisher; do
  run "install -m 0644 '$HERE/deploy/host/systemd/${u}.service' /etc/systemd/system/${u}.service"
done
run "install -m 0755 '$HERE/deploy/scripts/metrics-publisher.sh' /usr/local/bin/metrics-publisher.sh"
run "systemctl daemon-reload"
for u in xorg-core metrics-publisher mosquitto; do
  run "systemctl enable --now ${u}.service"
done
# R1: ensure mosquitto re-reads enode.conf (listener on HOST_IP) after deploy
run "systemctl restart mosquitto.service"

# Wait for the host X socket — the CT cannot bind it until it exists (B1 root cause).
if [ "$DRY_RUN" != 1 ]; then
  x0_n=0
  until [ -S /tmp/.X11-unix/X0 ]; do
    sleep 1; x0_n=$((x0_n + 1))
    if [ "$x0_n" -ge 30 ]; then
      log "ERROR: /tmp/.X11-unix/X0 not created by xorg-core.service within 30s."
      exit 1
    fi
  done
fi
log "Verified: host X socket /tmp/.X11-unix/X0 present."

# =====================================================================
# CT PHASE — create, bind devices, start, then install inside.
# =====================================================================
if pct status "$CT_ID" >/dev/null 2>&1; then
  log "CT $CT_ID already exists — reusing it (skipping pct create)."
else
  log "Step 2/6: Creating LXC container..."
  run "pct create $CT_ID $TEMPLATE --hostname $CT_NAME --storage $ROOTFS_STORAGE --memory 1024 --cores 1 --rootfs $ROOTFS_STORAGE:6 --net0 name=eth0,bridge=vmbr0,ip=dhcp --features nesting=1 --onboot 1 --unprivileged 0"
fi

log "Step 2b: Binding host devices into CT (X11 socket, input, dri)..."
run "add_mount_entry /etc/pve/lxc/$CT_ID.conf 'lxc.mount.entry: /tmp/.X11-unix/X0 opt/.X11-unix/X0 none bind,optional,create=file 0 0'"
run "add_mount_entry /etc/pve/lxc/$CT_ID.conf 'lxc.mount.entry: /dev/input dev/input none bind,optional,create=dir 0 0'"
run "add_mount_entry /etc/pve/lxc/$CT_ID.conf 'lxc.mount.entry: /dev/dri dev/dri none bind,optional,create=dir 0 0'"

# LXC create=file does not create the parent dir inside the CT; make it now
# (while the CT is stopped) so the X0 bind mount succeeds on start.
if [ "$DRY_RUN" != 1 ]; then
  if ! pct status "$CT_ID" 2>/dev/null | grep -q running; then
    run "pct mount $CT_ID"
    run "mkdir -p /var/lib/lxc/$CT_ID/rootfs/opt/.X11-unix"
    run "pct unmount $CT_ID"
  fi
fi

if ! pct status "$CT_ID" 2>/dev/null | grep -q running; then
  log "Step 3/6: Starting container..."
  run "pct start $CT_ID"
  log "Waiting for CT to boot (15s)..."
  sleep 15
fi

log "Step 4/6: Installing Node.js + git + chromium inside CT..."
run "pct exec $CT_ID -- bash -c 'apt-get update -qq && apt-get install -y -qq git curl nodejs npm chromium chromium-common'"
log "Step 5/6: Cloning e-Node repo from GitHub (anonymous)..."
run "pct exec $CT_ID -- bash -c 'rm -rf /var/www/e-node && git clone $REPO /var/www/e-node'"
run "pct exec $CT_ID -- bash -c 'cd /var/www/e-node && npm install --omit=dev'"

log "Writing local config (host IP: $HOST_IP)..."
run "pct exec $CT_ID -- bash -c 'mkdir -p /var/www/e-node/src'"
cat > /tmp/eNode-config.local.js.$$ <<CFG
// GENERATED by eNode-install — git-ignored
export const PROXMOX_NODE_URL = 'https://${HOST_IP}:8006';
CFG
run "pct exec $CT_ID -- bash -c 'cat > /var/www/e-node/src/config.local.js' < /tmp/eNode-config.local.js.$$"
rm -f /tmp/eNode-config.local.js.$$

# --- Inside CT: metrics-subscriber (writes host-metrics.json for the API) ---
log "Deploying CT-side metrics subscriber..."
run "pct exec $CT_ID -- bash -c 'apt-get update -qq && apt-get install -y -qq mosquitto-clients python3'"
run "pct exec $CT_ID -- bash -c 'mkdir -p /usr/local/bin /var/www/e-node/src/data'"
run "pct exec $CT_ID -- bash -c 'cat > /usr/local/bin/metrics-subscriber.sh' < '$HERE/deploy/scripts/metrics-subscriber.sh'"
run "pct exec $CT_ID -- bash -c 'chmod +x /usr/local/bin/metrics-subscriber.sh'"
# Substitute HOST_IP into the subscriber unit and deploy it INSIDE the CT (was a host-side bug before).
run "sed \"s/ENODE_HOST_IP/$HOST_IP/g\" '$HERE/deploy/host/systemd/metrics-subscriber.service' > /tmp/eNode-metrics-subscriber.service.$$"
run "pct exec $CT_ID -- bash -c 'cat > /etc/systemd/system/metrics-subscriber.service' < /tmp/eNode-metrics-subscriber.service.$$"
rm -f /tmp/eNode-metrics-subscriber.service.$$
run "pct exec $CT_ID -- bash -c 'systemctl daemon-reload && systemctl enable --now metrics-subscriber.service'"

# --- Inside CT: backend as systemd unit (survives CT reboot) ---
log "Deploying CT-side backend service..."
run "pct exec $CT_ID -- bash -c 'cat > /etc/systemd/system/enode-backend.service' < '$HERE/deploy/host/systemd/enode-backend.service'"
run "pct exec $CT_ID -- bash -c 'systemctl daemon-reload && systemctl enable --now enode-backend.service'"

# =====================================================================
# KIOSK PHASE — host service that drives Chromium inside the CT.
# =====================================================================
log "Step 6/6: Deploying host kiosk service (Type=simple, waits for CT)..."
SEDC="/tmp/eNode-kiosk.service.$$"
sed "s/__CT_ID__/$CT_ID/g" "$HERE/deploy/host/systemd/kiosk.service" > "$SEDC"
run "install -m 0644 '$SEDC' /etc/systemd/system/kiosk.service"
rm -f "$SEDC"
run "install -m 0755 '$HERE/deploy/scripts/kiosk-start.sh' /usr/local/bin/kiosk-start.sh"
run "systemctl daemon-reload"
run "systemctl enable --now kiosk.service"

# =====================================================================
# VERIFICATION
# =====================================================================
log "=== Verifying deployment ==="
verify_fail=0
if [ "$DRY_RUN" = 1 ]; then
  log "[dry-run] skipping live verification"
else
  if [ -S /tmp/.X11-unix/X0 ]; then
    log "  OK: host X socket /tmp/.X11-unix/X0 present"
  else
    log "  FAIL: host X socket /tmp/.X11-unix/X0 missing"; verify_fail=1
  fi
  if pct status "$CT_ID" 2>/dev/null | grep -q running; then
    log "  OK: CT $CT_ID running"
  else
    log "  FAIL: CT $CT_ID not running"; verify_fail=1
  fi
  if pct exec "$CT_ID" -- curl -fsS http://127.0.0.1:3000/api/health 2>/dev/null | grep -q '"status":"ok"'; then
    log "  OK: backend /api/health returns status=ok"
  else
    log "  FAIL: backend /api/health not ok"; verify_fail=1
  fi
  if ss -tlnp 2>/dev/null | grep -q ':1883'; then
    log "  OK: mosquitto listening on :1883"
  else
    log "  FAIL: mosquitto not listening on :1883"; verify_fail=1
  fi
  if pct exec "$CT_ID" -- systemctl is-active metrics-subscriber.service 2>/dev/null | grep -q active; then
    log "  OK: metrics-subscriber.service active in CT"
  else
    log "  FAIL: metrics-subscriber.service not active in CT"; verify_fail=1
  fi
  if systemctl is-active kiosk.service 2>/dev/null | grep -q active; then
    log "  OK: kiosk.service active on host"
  else
    log "  FAIL: kiosk.service not active on host"; verify_fail=1
  fi
  if xlsclients -display :0 2>/dev/null | grep -qi chromium; then
    log "  OK: Chromium present on physical display :0"
  else
    log "  WARN: Chromium not yet visible on :0 (may still be starting)"
  fi
  if pct exec "$CT_ID" -- test -s /var/www/e-node/src/data/host-metrics.json 2>/dev/null; then
    log "  OK: host-metrics.json is being written"
  else
    log "  WARN: host-metrics.json not present yet"
  fi
fi

if [ "$verify_fail" -ne 0 ]; then
  log "ERROR: deployment verification failed — see above. Install log: $LOG"
  exit 1
fi

log "=== Done ==="
log "eNode CT '$CT_NAME' (VMID $CT_ID) installed. Access the kiosk on the host display."
log "Update later with: eNode-update (inside CT: cd /var/www/e-node && git pull && npm install)"
log "Install log: $LOG"
