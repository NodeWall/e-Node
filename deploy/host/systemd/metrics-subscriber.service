[Unit]
Description=eNode Metrics Subscriber (MQTT → host-metrics.json)
After=network.target

[Service]
Type=simple
User=root
# BROKER is set by eNode-install to the host's IP (where mosquitto listens)
Environment=BROKER=${HOST_IP}
WorkingDirectory=/var/www/e-node
ExecStart=/usr/local/bin/metrics-subscriber.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
