[Unit]
Description=eNode Backend (Fastify)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/e-node
# --experimental-websocket enables the built-in WebSocket global used by the
# in-process BrowserBridge (CDP Page.navigate for the ControlPanel Home action).
ExecStart=/usr/bin/node --experimental-websocket /var/www/e-node/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
