#!/usr/bin/env bash
#
# eNode-update — pull latest eNode from GitHub inside the CT (no reinstall).
# Run INSIDE the eNode CT:  bash eNode-update
#
set -euo pipefail
cd "$(dirname "$0")"

echo "=== eNode Update ==="
git fetch origin
LOCAL="$(git rev-parse HEAD)"
REMOTE="$(git rev-parse origin/main 2>/dev/null || git rev-parse origin/master)"
if [ "$LOCAL" = "$REMOTE" ]; then
  echo "Already up to date ($LOCAL)."
  exit 0
fi

git pull --ff-only
npm install --omit=dev
echo "Updated to $(git rev-parse --short HEAD)."
echo "Restart backend/kiosk services if running (systemctl restart kiosk.service)."
